# === База данных ===
DB_TYPE=sqlite

# PostgreSQL (только если DB_TYPE=postgresql)
DB_USER=masterdelo
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterdelo

# === Безопасность ===
# Минимум 64 символа. Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замени-обязательно-минимум-64-символа

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# === Окружение ===
# development — Swagger доступен, логи подробные
# production  — Swagger отключён, строгие лимиты
ENVIRONMENT=development

# === CORS — только конкретные домены, без wildcard * ===
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Для prod:
# ALLOWED_ORIGINS=https://yourdomain.ru,https://www.yourdomain.ru

# === Загрузка файлов ===
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=static/uploads

# === Rate limiting backend ===
# memory:// — для dev/single-instance
# redis://localhost:6379 — для prod/multi-instance
RATE_LIMIT_STORAGE=memory://
