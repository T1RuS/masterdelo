# База данных (sqlite или postgresql)
DB_TYPE=sqlite

# PostgreSQL (только если DB_TYPE=postgresql)
DB_USER=masterdelo
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterdelo

# JWT
SECRET_KEY=замени-на-случайную-строку-минимум-32-символа-здесь
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Загрузка файлов
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=static/uploads

# CORS (через запятую)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
